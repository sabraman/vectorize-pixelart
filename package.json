{
  "name": "vectorize-pixelart",
  "version": "0.2.0",
  "description": "Convert raster pixel art graphics to vector",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc",
    "test": "vitest run",
    "lint": "ts-standard src/",
    "format": "ts-standard --fix src/"
  },
  "directories": {
    "lib": "./lib",
    "test": "./test"
  },
  "author": "Serhii Zasenko",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.2.1",
    "next": "^16.2.4",
    "standard": "^17.1.2",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabraman/vectorize-pixelart.git"
  },
  "bin": {
    "vectorize-pixelart": "lib/vectorize-pixelart.js"
  },
  "keywords": [
    "vector",
    "svg",
    "convert"
  ],
  "bugs": {
    "url": "https://github.com/sabraman/vectorize-pixelart/issues"
  },
  "homepage": "https://github.com/sabraman/vectorize-pixelart#readme",
  "packageManager": "bun@1.3.3"
